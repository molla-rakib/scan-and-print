# ─── App ────────────────────────────────────────────────────────────────
# Public URL of the website (used for QR codes, bKash callbacks and Google login).
APP_URL=http://localhost:3000

# Long random string for signing login sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# 32 random bytes (base64) used to encrypt shop owners' bKash credentials.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me

# Comma-separated Google account emails that get the admin panel.
ADMIN_EMAILS=admin@example.com

# ─── Google login ───────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── MongoDB (docker compose) ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/scan-and-print?replicaSet=rs0&directConnection=true

# ─── MinIO / S3 file storage (docker compose) ───────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Endpoint the server uses to reach MinIO.
S3_ENDPOINT=http://localhost:9000
# Endpoint customers' browsers and shop agents use (must be reachable from the internet in production).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=print-jobs

# ─── Business rules ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
# Monthly fee per enabled device (BDT).
DEVICE_MONTHLY_FEE=300
# New shops get a free trial.
TRIAL_DAYS=14
TRIAL_DEVICE_LIMIT=1
